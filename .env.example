# Copy to backend/.env and adjust. Never commit real secrets.

# PostgreSQL (docker compose up -d db starts one with these credentials)
DATABASE_URL=postgresql+psycopg://missioncontrol:missioncontrol@localhost:5432/missioncontrol

# Self-hosted MCP server (Streamable HTTP)
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# Backend API
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Planner: "rule" (deterministic, no external calls) or "bedrock"
AI_PROVIDER=rule
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Bedrock-only IAM keys (leave empty to use the standard AWS credential chain, e.g. ~/.aws/credentials).
# backend/.env is git-ignored: never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Agent limits
AGENT_MAX_TOOL_CALLS=12
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_MISSION_TIMEOUT_SECONDS=90
AGENT_MAX_RETRIES=1

# Demo user created by `python -m app.cli seed`. Change this token.
DEMO_USER_NAME=Demo User
DEMO_USER_TOKEN=change-me-demo-token
